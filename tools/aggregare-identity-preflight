#!/usr/bin/env python3
"""Check identity DNS, TLS trust, and OIDC discovery without changing the host."""

import argparse
import json
from pathlib import Path
import socket
import ssl
import subprocess
import sys
import urllib.error
import urllib.request
from urllib.parse import urlsplit


TIMEOUT = 8


def resolve(host):
    """Return unique IP addresses for host, or raise a useful error."""
    records = socket.getaddrinfo(host, None, type=socket.SOCK_STREAM)
    addresses = sorted({record[4][0] for record in records}, key=lambda value: (":" in value, value))
    if not addresses:
        raise OSError("no addresses returned")
    return addresses


def validate_url(value, label):
    parsed = urlsplit(value)
    if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password:
        raise ValueError(f"{label} must be an HTTPS URL with a hostname and no embedded credentials")
    if parsed.fragment:
        raise ValueError(f"{label} must not contain a fragment")
    return parsed


def check_tls(host, port, cafile):
    context = ssl.create_default_context(cafile=cafile)
    with socket.create_connection((host, port), timeout=TIMEOUT) as raw:
        with context.wrap_socket(raw, server_hostname=host) as secured:
            return secured.version()


def fetch_discovery(issuer, cafile):
    url = issuer.rstrip("/") + "/.well-known/openid-configuration"
    context = ssl.create_default_context(cafile=cafile)
    request = urllib.request.Request(url, headers={"Accept": "application/json"})
    with urllib.request.urlopen(request, context=context, timeout=TIMEOUT) as response:
        if urlsplit(response.geturl()).scheme != "https":
            raise ValueError("discovery redirected to a non-HTTPS URL")
        if response.status < 200 or response.status >= 300:
            raise OSError(f"discovery returned HTTP {response.status}")
        document = json.loads(response.read())
    if document.get("issuer") != issuer:
        raise ValueError("discovery document issuer does not exactly match the configured issuer URL")
    insecure = [key for key, value in document.items() if key.endswith("_endpoint") and isinstance(value, str)
                and urlsplit(value).scheme != "https"]
    if insecure:
        raise ValueError("discovery advertises non-HTTPS endpoint(s): " + ", ".join(sorted(insecure)))
    return url, sorted(key for key in document if key.endswith("_endpoint"))


def run_checks(origin, issuer, cafile):
    origin_url = validate_url(origin, "origin")
    issuer_url = validate_url(issuer, "issuer")
    checks = []
    for label, host, port in (("origin", origin_url.hostname, origin_url.port or 443),
                              ("issuer", issuer_url.hostname, issuer_url.port or 443)):
        try:
            addresses = resolve(host)
            checks.append({"name": f"{label}_dns", "status": "passed", "host": host, "addresses": addresses})
        except (OSError, UnicodeError) as exc:
            checks.append({"name": f"{label}_dns", "status": "failed", "host": host, "detail": str(exc)})
            continue
        try:
            version = check_tls(host, port, cafile)
            checks.append({"name": f"{label}_tls", "status": "passed", "host": host,
                           "port": port, "protocol": version})
        except (OSError, ssl.SSLError, ValueError) as exc:
            checks.append({"name": f"{label}_tls", "status": "failed", "host": host, "port": port,
                           "detail": str(exc)})
    if any(check["name"] == "issuer_tls" and check["status"] == "passed" for check in checks):
        try:
            discovery, endpoints = fetch_discovery(issuer, cafile)
            checks.append({"name": "issuer_discovery", "status": "passed", "url": discovery,
                           "https_endpoints": endpoints})
        except (OSError, ssl.SSLError, ValueError, UnicodeError, json.JSONDecodeError) as exc:
            checks.append({"name": "issuer_discovery", "status": "failed", "url": issuer,
                           "detail": str(exc)})
    return checks


def check_context(name, origin, issuer, cafile):
    if name == "host":
        return run_checks(origin, issuer, cafile)
    source = Path(__file__).read_bytes()
    import base64
    encoded = base64.b64encode(source).decode("ascii")
    remote = ("import base64,sys; ns={'__name__':'identity_preflight_remote'}; "
              f"exec(compile(base64.b64decode('{encoded}'), '<identity-preflight>', 'exec'), ns); "
              f"print(json.dumps(ns['run_checks']({origin!r},{issuer!r},{cafile!r})))")
    try:
        result = subprocess.run(["podman", "exec", name, "python3", "-c", remote],
                                capture_output=True, text=True, timeout=TIMEOUT * 3, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return [{"name": "container_preflight", "status": "failed", "detail": str(exc)}]
    if result.returncode:
        detail = result.stderr.strip() or f"podman exec exited {result.returncode}"
        return [{"name": "container_preflight", "status": "failed", "detail": detail}]
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return [{"name": "container_preflight", "status": "failed",
                 "detail": "container returned an invalid preflight report"}]


def make_report(origin, issuer, cafile, containers):
    contexts = [{"name": "host", "checks": check_context("host", origin, issuer, cafile)}]
    contexts.extend({"name": container,
                     "checks": check_context(container, origin, issuer, cafile)} for container in containers)
    passed = all(check["status"] == "passed" for context in contexts for check in context["checks"])
    return {"schema_version": "v1", "status": "passed" if passed else "failed",
            "origin": origin, "issuer": issuer, "contexts": contexts}


def render_text(report):
    print(f"Identity preflight: {report['status']}")
    for context in report["contexts"]:
        print(f"[{context['name']}]")
        for check in context["checks"]:
            detail = check.get("addresses") or check.get("protocol") or check.get("url") or check.get("detail", "")
            print(f"  {check['status']}: {check['name']}" + (f" — {detail}" if detail else ""))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--origin", required=True, help="trusted HTTPS identity origin")
    parser.add_argument("--issuer", required=True, help="canonical HTTPS OIDC issuer URL")
    parser.add_argument("--cafile", help="optional PEM CA bundle for a private CA")
    parser.add_argument("--container", action="append", default=[], metavar="NAME",
                        help="also check an explicitly named Podman container (repeatable; requires python3 there)")
    parser.add_argument("--format", choices=("text", "json"), default="text")
    args = parser.parse_args(argv)
    if args.cafile and not Path(args.cafile).is_file():
        parser.error("--cafile must name a readable CA bundle file")
    report = make_report(args.origin, args.issuer, args.cafile, args.container)
    if args.format == "json":
        json.dump(report, sys.stdout, indent=2)
        sys.stdout.write("\n")
    else:
        render_text(report)
    return 0 if report["status"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
