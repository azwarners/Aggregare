#!/usr/bin/env python3
"""Ephemeral Git credential helper for a future root-owned publication runner.

Git calls credential helpers with stdout connected to a pipe. Refusing a terminal
prevents accidental token display by an administrator or an interactive model.
"""
import os
import stat
import sys

sys.path.insert(0, "/usr/local/lib/aggregare")
from redless_github_app import AppError, config, installation_token, repository_accessible


def main() -> int:
    # Git provides a FIFO for credential output.  Reject terminals and regular
    # files so a direct invocation cannot display or persist an installation token.
    if os.geteuid() != 0 or os.isatty(1) or not stat.S_ISFIFO(os.fstat(1).st_mode):
        raise AppError("Git credentials are available only to a noninteractive root-owned runner")
    if len(sys.argv) != 2 or sys.argv[1] != "get":
        raise AppError("only the Git credential get operation is supported")
    fields = dict(line.rstrip("\n").split("=", 1) for line in sys.stdin if "=" in line)
    if fields.get("protocol") != "https" or fields.get("host") != "github.com":
        raise AppError("Git credential request is not for github.com HTTPS")
    path = fields.get("path", "").strip("/")
    # Git sends HTTPS remotes as OWNER/REPOSITORY.git when useHttpPath is set.
    if path.endswith(".git"):
        path = path[:-4]
    settings = config()
    token = installation_token(settings)
    repository_accessible(settings, token, path)
    # This output is Git's private credential pipe, never a terminal or a file.
    sys.stdout.write(f"username=x-access-token\npassword={token}\n\n")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except AppError as error:
        print(f"redless-github-app-git: {error}", file=sys.stderr)
        raise SystemExit(1)
