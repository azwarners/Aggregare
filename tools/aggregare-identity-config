#!/usr/bin/env python3
"""Read and write Aggregare's versioned, non-secret identity selection."""
import json
from pathlib import Path
import sys

PROVIDERS = {"kanidm", "external_oidc", "none"}


def load(path):
    try:
        data = json.loads(Path(path).read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"cannot read identity config: {exc}") from exc
    if (not isinstance(data, dict) or data.get("schema_version") != 1
            or data.get("identity_provider") not in PROVIDERS
            or set(data) != {"schema_version", "identity_provider"}):
        raise ValueError("expected schema_version 1 and identity_provider kanidm, external_oidc, or none")
    return data


def main(argv):
    if len(argv) == 3 and argv[1] == "get-provider":
        try:
            print(load(argv[2])["identity_provider"])
        except ValueError as exc:
            print(f"aggregare-identity-config: {exc}", file=sys.stderr)
            return 2
        return 0
    print("Usage: aggregare-identity-config get-provider FILE", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
