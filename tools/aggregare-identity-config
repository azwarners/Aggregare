#!/usr/bin/env python3
"""Read Aggregare's versioned, non-secret identity configuration."""
import json
from pathlib import Path
import sys

PROVIDERS = {"kanidm", "external_oidc", "none"}


def load(path):
    try:
        data = json.loads(Path(path).read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"cannot read identity config: {exc}") from exc
    if not isinstance(data, dict) or data.get("identity_provider") not in PROVIDERS:
        raise ValueError("identity config must contain a supported identity_provider")
    if data.get("schema_version") == 1 and set(data) == {"schema_version", "identity_provider"}:
        return data
    expected = {"schema_version", "identity_provider", "identity_domain", "identity_origin"}
    if (data.get("schema_version") != 2 or data.get("identity_provider") != "kanidm"
            or set(data) != expected or not data["identity_domain"] or not data["identity_origin"]):
        raise ValueError("expected a valid version 1 identity selection or version 2 Kanidm domain and origin")
    return data


def main(argv):
    if len(argv) == 3 and argv[1] == "get-provider":
        try:
            print(load(argv[2])["identity_provider"])
        except ValueError as exc:
            print(f"aggregare-identity-config: {exc}", file=sys.stderr)
            return 2
        return 0
    if len(argv) == 4 and argv[1] == "get-field":
        try:
            data = load(argv[3])
            if argv[2] not in data:
                return 0
            print(data[argv[2]])
        except ValueError as exc:
            print(f"aggregare-identity-config: {exc}", file=sys.stderr)
            return 2
        return 0
    print("Usage: aggregare-identity-config get-provider FILE | get-field FIELD FILE", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
