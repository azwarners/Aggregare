#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
ANSIBLE_DIR="$REPO_ROOT/ansible"
INVENTORY_FILE="$ANSIBLE_DIR/inventory.ini"
VAULT_FILE="$ANSIBLE_DIR/group_vars/aggregare/vault.yml"

if [[ ! -f "$INVENTORY_FILE" ]]; then
  printf 'Aggregare inventory not found at %s. Run the installer first.\n' "$INVENTORY_FILE" >&2
  exit 1
fi
if ! command -v sudo >/dev/null 2>&1; then
  printf 'sudo is required to update the HabitSync service.\n' >&2
  exit 1
fi
ANSIBLE_PLAYBOOK="$(command -v ansible-playbook || true)"
if [[ -z "$ANSIBLE_PLAYBOOK" ]]; then
  printf 'ansible-playbook was not found. Run this from an Aggregare host with Ansible installed.\n' >&2
  exit 1
fi

ADMIN_NAME="$(id -un)"
if [[ ! "$ADMIN_NAME" =~ ^[a-z0-9][a-z0-9-]{0,35}$ ]]; then
  printf 'HabitSync requires a lowercase username containing only letters, digits, and hyphens; got %s.\n' "$ADMIN_NAME" >&2
  exit 1
fi
ADMIN_UID="$(id -u)"
ADMIN_GID="$(id -g)"
ADMIN_HOME="$(getent passwd "$ADMIN_NAME" | cut -d: -f6)"

EXTRA_VARS="$(python3 - "$ADMIN_NAME" "$ADMIN_UID" "$ADMIN_GID" "$ADMIN_HOME" <<'PY'
import json
import sys

print(json.dumps({
    "habitsync_recovery_user": sys.argv[1],
    "aggregare_report_admin_uid": sys.argv[2],
    "aggregare_report_admin_gid": sys.argv[3],
    "aggregare_report_admin_home": sys.argv[4],
}))
PY
)"

VAULT_ARGS=()
if [[ -f "$VAULT_FILE" ]]; then
  IFS= read -r VAULT_HEADER < "$VAULT_FILE" || true
  if [[ "$VAULT_HEADER" == \$ANSIBLE_VAULT\;* ]]; then
    VAULT_ARGS+=(--ask-vault-pass)
  fi
fi

cd "$ANSIBLE_DIR"
sudo "$ANSIBLE_PLAYBOOK" \
  -i inventory.ini \
  playbooks/habitsync-password.yml \
  --extra-vars "$EXTRA_VARS" \
  "${VAULT_ARGS[@]}"
