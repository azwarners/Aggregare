#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
ANSIBLE_DIR="$REPO_ROOT/ansible"
INVENTORY_FILE="$ANSIBLE_DIR/inventory.ini"
VAULT_FILE="$ANSIBLE_DIR/group_vars/aggregare/vault.yml"
INSTALL_STATE_FILE="/var/lib/aggregare/installer-state.json"

if [[ ! -f "$INVENTORY_FILE" ]]; then
  printf 'Aggregare inventory not found at %s. Run the installer first.\n' "$INVENTORY_FILE" >&2
  exit 1
fi
if ! command -v sudo >/dev/null 2>&1; then
  printf 'sudo is required to update the HabitSync service.\n' >&2
  exit 1
fi
ANSIBLE_PLAYBOOK="$(command -v ansible-playbook || true)"
if [[ -z "$ANSIBLE_PLAYBOOK" ]]; then
  printf 'ansible-playbook was not found. Run this from an Aggregare host with Ansible installed.\n' >&2
  exit 1
fi

ADMIN_NAME="$(id -un)"
if [[ ! "$ADMIN_NAME" =~ ^[a-z0-9][a-z0-9-]{0,35}$ ]]; then
  printf 'HabitSync requires a lowercase username containing only letters, digits, and hyphens; got %s.\n' "$ADMIN_NAME" >&2
  exit 1
fi
ADMIN_UID="$(id -u)"
ADMIN_GID="$(id -g)"
ADMIN_HOME="$(getent passwd "$ADMIN_NAME" | cut -d: -f6)"
LAN_ACCESS="$(sudo python3 - "$INSTALL_STATE_FILE" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as state_file:
        state = json.load(state_file)
except (OSError, json.JSONDecodeError) as error:
    raise SystemExit(f"could not read installer state at {sys.argv[1]}: {error}")
value = state.get("lan_access")
if not isinstance(value, bool):
    raise SystemExit("installer state does not contain a valid lan_access choice")
print("true" if value else "false")
PY
)"

if [[ "$LAN_ACCESS" == true ]]; then
  LAN_INTERFACE="$(ip -4 route show default 2>/dev/null | awk 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')"
  LAN_CIDR="$(ip -o -4 addr show dev "$LAN_INTERFACE" scope global 2>/dev/null | awk 'NR == 1 { print $4 }')"
  if [[ -z "$LAN_INTERFACE" || -z "$LAN_CIDR" ]]; then
    printf 'The installer has LAN access enabled, but I could not detect its private LAN address. Restore the network and try again.\n' >&2
    exit 1
  fi
  LAN_ADDRESS="$(python3 - "$LAN_CIDR" <<'PY'
import ipaddress
import sys

address = ipaddress.ip_interface(sys.argv[1]).ip
rfc1918 = (
    ipaddress.ip_network("10.0.0.0/8"),
    ipaddress.ip_network("172.16.0.0/12"),
    ipaddress.ip_network("192.168.0.0/16"),
)
if not any(address in network for network in rfc1918):
    raise SystemExit("the detected address is not a private IPv4 address")
print(address)
PY
)"
  HABITSYNC_BIND_ADDRESS="$LAN_ADDRESS"
else
  HABITSYNC_BIND_ADDRESS="127.0.0.1"
fi

HABITSYNC_BASE_URL="$(sudo awk 'index($0, "Environment=BASE_URL=") == 1 { sub(/^Environment=BASE_URL=/, ""); print; exit }' /etc/containers/systemd/habitsync.container 2>/dev/null || true)"
if [[ "$LAN_ACCESS" == true && "$HABITSYNC_BASE_URL" == "http://127.0.0.1:6842" ]]; then
  HABITSYNC_BASE_URL="http://$LAN_ADDRESS:6842"
elif [[ -z "$HABITSYNC_BASE_URL" ]]; then
  HABITSYNC_BASE_URL="http://$HABITSYNC_BIND_ADDRESS:6842"
fi

EXTRA_VARS="$(python3 - "$ADMIN_NAME" "$ADMIN_UID" "$ADMIN_GID" "$ADMIN_HOME" "$HABITSYNC_BIND_ADDRESS" "$HABITSYNC_BASE_URL" <<'PY'
import json
import sys

print(json.dumps({
    "habitsync_recovery_user": sys.argv[1],
    "aggregare_report_admin_uid": sys.argv[2],
    "aggregare_report_admin_gid": sys.argv[3],
    "aggregare_report_admin_home": sys.argv[4],
    "habitsync_bind_address": sys.argv[5],
    "habitsync_base_url": sys.argv[6],
    "aggregare_report_bind_address": sys.argv[5],
}))
PY
)"

VAULT_ARGS=()
if [[ -f "$VAULT_FILE" ]]; then
  IFS= read -r VAULT_HEADER < "$VAULT_FILE" || true
  if [[ "$VAULT_HEADER" == \$ANSIBLE_VAULT\;* ]]; then
    VAULT_ARGS+=(--ask-vault-pass)
  fi
fi

cd "$ANSIBLE_DIR"
sudo "$ANSIBLE_PLAYBOOK" \
  -i inventory.ini \
  playbooks/habitsync-password.yml \
  --extra-vars "$EXTRA_VARS" \
  "${VAULT_ARGS[@]}"
