{
  "id": "ai-chat",
  "display_name": "AI chat stack",
  "description": "Additive AI chat component set: Open WebUI chat interface, Ysparr OpenAI-compatible relay, and Apmatia package.",
  "applications": ["ysparr", "apmatia", "open-webui"],
  "dependencies": {
    "ysparr": ["system:git", "system:python3", "system:python3-venv"],
    "apmatia": ["system:git", "system:python3", "system:python3-venv"],
    "open-webui": ["system:podman>=4.9", "application:ysparr"]
  },
  "entry_point": "ansible/playbooks/ai-chat.yml",
  "application_order": ["ysparr", "apmatia", "open-webui"],
  "persistent_paths": [
    "/var/lib/ysparr",
    "/var/lib/aggregare/open-webui",
    "/opt/aggregare/apmatia",
    "/opt/aggregare/venvs/apmatia"
  ],
  "upstream_pins": {
    "open-webui-image": "ghcr.io/open-webui/open-webui:v0.11.4",
    "ysparr-git": "264bc9c10ea3efdc21059767b58f20c4b07897cb",
    "apmatia-git": "a72eeb8fd9319c304e98968d2be4124840540617"
  },
  "notes": [
    "Applications retain independent playbooks.",
    "External model URL and Apmatia API service bootstrap are not configured by this component set yet."
  ]
}
