{
  "id": "default",
  "display_name": "Aggregare default operating system",
  "description": "The default Aggregare system includes the AI chat applications and core productivity applications.",
  "applications": ["ysparr", "apmatia", "open-webui", "memos", "habitsync", "vikunja", "openipe"],
  "entry_point": "ansible/playbooks/default.yml",
  "application_order": ["ysparr", "apmatia", "open-webui", "memos", "habitsync", "vikunja", "openipe"],
  "dependencies": {
    "open-webui": ["application:ysparr"],
    "habitsync": ["system:podman", "system:openssl", "system:apache2-utils"],
    "vikunja": ["system:podman"],
    "memos": ["system:podman>=4.9"]
  },
  "upstream_pins": {
    "open-webui-image": "ghcr.io/open-webui/open-webui:v0.11.4",
    "memos-image": "ghcr.io/usememos/memos:0.31.0",
    "habitsync-image": "ghcr.io/jofoerster/habitsync:0.19.3",
    "vikunja-image": "docker.io/vikunja/vikunja:2.6.0",
    "ysparr-git": "264bc9c10ea3efdc21059767b58f20c4b07897cb",
    "apmatia-git": "a72eeb8fd9319c304e98968d2be4124840540617",
    "openipe-git": "da7842181cca04c05ebbc19cef9cf50759e709b7"
  },
  "persistent_paths": [
    "/var/lib/ysparr",
    "/var/lib/aggregare/open-webui",
    "/var/lib/aggregare/memos",
    "/var/lib/aggregare/habitsync",
    "/var/lib/aggregare/vikunja",
    "/etc/aggregare/secrets/habitsync-jwt",
    "/etc/aggregare/secrets/habitsync-password",
    "/etc/aggregare/habitsync-credentials"
  ],
  "notes": [
    "AI chat and productivity applications install together; installing this bundle does not remove or replace existing applications.",
    "OpenIPE and Apmatia are currently installed as pinned Python packages; their API/service integration is managed separately."
  ]
}
