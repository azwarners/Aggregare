{
  "id": "open-webui",
  "display_name": "Open WebUI",
  "description": "Persistent self-hosted chat interface configured to use Ysparr as its sole model provider.",
  "ownership": "third-party",
  "category": "ai-chat-client",
  "source": {
    "name": "open-webui/open-webui",
    "upstream": "https://github.com/open-webui/open-webui"
  },
  "version": "0.11.4",
  "status": "supported",
  "install_methods": [
    "oci-container"
  ],
  "capabilities": {
    "install": true,
    "update": true,
    "remove": true,
    "verify": true
  },
  "unsupported_operations": [
    "automatic-backup",
    "agent-tools-configuration",
    "rag-configuration",
    "workspace-tools-and-pipelines-configuration"
  ],
  "entry_point": "ansible/playbooks/open-webui.yml",
  "deployments": [
    {
      "method": "oci-container",
      "backend": "ansible",
      "entry_point": "ansible/playbooks/open-webui.yml",
      "requirements": [
        "system:podman>=4.9",
        "application:ysparr"
      ],
      "reference": "ghcr.io/open-webui/open-webui:v0.11.4",
      "image": "ghcr.io/open-webui/open-webui:v0.11.4"
    }
  ],
  "platforms": [
    {
      "name": "ubuntu",
      "versions": [
        "24.04",
        "26.04"
      ],
      "architectures": [
        "amd64",
        "arm64"
      ]
    }
  ],
  "dependencies": [
    "system:podman>=4.9",
    "application:ysparr"
  ],
  "conflicts": [],
  "services": [
    {
      "name": "open-webui.service",
      "ports": [
        8080
      ],
      "data_paths": [
        "/var/lib/aggregare/open-webui"
      ],
      "endpoints": [
        "http://127.0.0.1:8080/health"
      ]
    }
  ],
  "configuration": [],
  "authentication": {
    "methods": ["local"],
    "bootstrap": {
      "mode": "first-run-ui",
      "idempotent": true,
      "notes": "The first account created through the browser on a fresh database becomes the administrator. Sign-up is enabled for first use and should be disabled in the Admin Panel after setup."
    },
    "manual_steps": [
      "Create the first administrator account through the Open WebUI browser interface.",
      "Disable new account sign-up in Admin Panel > Settings after creating the first account."
    ]
  },
  "secret_references": [],
  "integrations": [
    "application:ysparr",
    "openai-compatible-http"
  ]
}
