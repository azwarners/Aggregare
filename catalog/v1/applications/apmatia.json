{
  "id": "apmatia",
  "display_name": "Apmatia",
  "description": "Apmatia core API with persistent state, a protected first-user credential, a default upstream model, and published prompt-only starter agents.",
  "ownership": "aggregare",
  "category": "identity-context",
  "source": {
    "name": "Aggregare / Apmatia",
    "upstream": "https://github.com/azwarners/Apmatia"
  },
  "version": "0.0.1.7",
  "status": "experimental",
  "install_methods": [
    "native-python-service"
  ],
  "capabilities": {
    "install": true,
    "update": true,
    "remove": true,
    "verify": true,
    "service_management": true
  },
  "entry_point": "ansible/playbooks/apmatia.yml",
  "deployments": [
    {
      "method": "native-python-service",
      "backend": "ansible",
      "entry_point": "ansible/playbooks/apmatia.yml",
      "reference": "bddc27cb369579cc5f912a556aab1612e2034482",
      "requirements": [
        "system:git",
        "system:python3",
        "system:python3-venv",
        "system:openssl"
      ]
    }
  ],
  "platforms": [
    {
      "name": "ubuntu",
      "versions": [
        "24.04",
        "26.04"
      ],
      "architectures": [
        "amd64",
        "arm64"
      ]
    }
  ],
  "dependencies": [
    "system:git",
    "system:python3",
    "system:python3-venv",
    "system:openssl"
  ],
  "conflicts": [],
  "authentication": {
    "methods": ["local"],
    "bootstrap": {
      "mode": "api",
      "idempotent": true,
      "credential_reference": "/etc/aggregare/apmatia-credentials.json",
      "notes": "Fresh installs generate a first-user password; existing user databases without this saved credential are left unchanged."
    },
    "manual_steps": ["Back up the root-only first-user credential file securely."]
  },
  "secret_references": ["ansible-vault:ysparr_upstream_api_key"],
  "services": [
    {
      "name": "apmatia-core.service",
      "ports": [8001],
      "data_paths": ["/var/lib/apmatia/app", "/var/lib/apmatia/data", "/var/lib/apmatia/config"],
      "endpoints": ["http://127.0.0.1:8001/api/version", "http://127.0.0.1:8001/api/public/agents"]
    }
  ],
  "integrations": ["ysparr-public-agents"]
}
