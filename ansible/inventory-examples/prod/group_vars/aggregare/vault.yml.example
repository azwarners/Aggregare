# Copy to vault.yml, replace every value, then encrypt the copy with
# ansible-vault encrypt. Never copy values from the dev Vault.
habitsync_jwt_secret: "GENERATE-A-DIFFERENT-PRODUCTION-ONLY-KEY"
habitsync_recovery_user: "replace-with-a-prod-local-recovery-user"
habitsync_recovery_password_hash: "GENERATE-A-BCRYPT-HASH-OF-A-UNIQUE-PROD-PASSWORD"
