[Unit]
Description={{ python_app_id }} native Python service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ python_app_service_user }}
Group={{ python_app_service_group }}
WorkingDirectory={{ python_app_service_working_directory }}
{% for key, value in python_app_service_environment | dictsort %}
Environment={{ key }}={{ value | quote }}
{% endfor %}
ExecStart={{ python_app_service_exec_start }}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
{% if python_app_service_read_write_paths %}
ReadWritePaths={{ python_app_service_read_write_paths | join(' ') }}
{% endif %}
UMask=0027

[Install]
WantedBy=multi-user.target
