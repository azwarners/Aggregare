[Unit]
Description=Aggregare managed {{ application_id }} container
Wants=network-online.target
After=network-online.target

[Container]
ContainerName={{ application_id }}
Image={{ application_image }}
Timezone=local
{% if application_host_network | default(false) %}
Network=host
{% endif %}
{% if application_user | length > 0 %}
User={{ application_user }}
{% endif %}
{% for host in application_add_hosts | default([]) %}
AddHost={{ host.name }}:{{ host.address }}
{% endfor %}
{% if 'TZ' not in (application_environment | default({})) %}
Environment=TZ={{ host_timezone }}
{% endif %}
{% if not (application_host_network | default(false)) %}
PublishPort={{ application_bind_address }}:{{ application_host_port }}:{{ application_container_port }}
{% endif %}
{% if application_system_ca_bundle | default(false) %}
Volume=/etc/ssl/certs/ca-certificates.crt:/etc/ssl/certs/ca-certificates.crt:ro
{% endif %}
{% if application_java_trust_store | default(false) %}
Volume=/etc/ssl/certs/java/cacerts:/opt/java/openjdk/lib/security/cacerts:ro
{% endif %}
{% if application_volumes | length > 0 %}
{% for volume in application_volumes %}
Volume={{ volume.host }}:{{ volume.container }}{{ ':' ~ volume.options if volume.options is defined else '' }}
{% endfor %}
{% else %}
Volume={{ application_data_path }}:{{ application_container_data_path }}
{% endif %}
{% for key, value in application_environment | default({}) | dictsort %}
Environment={{ key }}={{ value }}
{% endfor %}
{% if application_secret_environment | length > 0 %}
EnvironmentFile=/etc/aggregare/{{ application_id }}.env
{% endif %}

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
