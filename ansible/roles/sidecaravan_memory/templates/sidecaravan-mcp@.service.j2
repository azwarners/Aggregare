[Unit]
Description=Sidecaravan MCP session
After=network.target

[Service]
Type=simple
User=root
Group={{ sidecaravan_group }}
WorkingDirectory={{ sidecaravan_source_dir }}
ExecStart={{ sidecaravan_wrapper }} mcp
StandardInput=socket
StandardOutput=socket
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ sidecaravan_data_dir }}
UMask=0027
