[Unit]
Description=Aggregare Kanidm identity service
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=aggregare-kanidm
Image={{ aggregare_kanidm_image }}
User=1000:1000
PublishPort=127.0.0.1:8443:8443
Volume={{ aggregare_kanidm_data_dir }}:/data:Z
ReadOnly=true
Tmpfs=/tmp

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
