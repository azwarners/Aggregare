{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aggregare.invalid/schemas/v1/execution-result.schema.json",
  "title": "Structured execution result (v1)",
  "type": "object",
  "required": ["task_id", "loop_owner", "status"],
  "properties": {
    "task_id": { "type": "string" },
    "loop_owner": { "type": "string" },
    "status": { "enum": ["succeeded", "failed", "unavailable", "cancelled"] },
    "output": {},
    "error": { "type": "object", "required": ["code", "message", "retryable"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "retryable": { "type": "boolean" }, "details": { "type": "object" } }, "additionalProperties": false }
  },
  "allOf": [
    { "if": { "properties": { "status": { "enum": ["failed", "unavailable"] } }, "required": ["status"] }, "then": { "required": ["error"] } },
    { "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] }, "then": { "not": { "required": ["error"] } } }
  ],
  "additionalProperties": false
}
