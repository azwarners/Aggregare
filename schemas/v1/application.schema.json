{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aggregare.invalid/schemas/v1/application.schema.json",
  "title": "Aggregare application catalog entry (v1)",
  "type": "object",
  "required": ["id", "source", "install_methods", "capabilities"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "ownership": { "enum": ["aggregare", "third-party"] },
    "category": { "type": "string", "minLength": 1 },
    "source": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "upstream": { "type": "string", "format": "uri-reference" } }, "additionalProperties": false },
    "install_methods": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "entry_point": { "type": "string" },
    "deployments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/deployment" } },
    "platforms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/platform" } },
    "status": { "type": "string", "enum": ["supported", "experimental", "planned", "blocked", "deprecated"] },
    "version": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "conflicts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "services": { "type": "array", "items": { "$ref": "#/$defs/service" } },
    "configuration": { "type": "array", "items": { "$ref": "#/$defs/configuration" } },
    "authentication": { "$ref": "#/$defs/authentication" },
    "secret_references": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "capabilities": { "type": "object", "required": ["install", "update", "remove", "verify"], "properties": { "install": { "type": "boolean" }, "update": { "type": "boolean" }, "remove": { "type": "boolean" }, "verify": { "type": "boolean" } }, "additionalProperties": { "type": "boolean" } },
    "integrations": { "type": "array", "items": { "type": "string" } },
    "unsupported_operations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false,
  "$defs": {
    "deployment": {
      "type": "object",
      "required": ["method", "backend", "entry_point"],
      "properties": {
        "method": { "type": "string" },
        "backend": { "type": "string" },
        "entry_point": { "type": "string" },
        "reference": { "type": "string" },
        "image": { "type": "string" },
        "requirements": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "required": ["name", "versions"],
      "properties": {
        "name": { "type": "string" },
        "versions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "architectures": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "service": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 }, "uniqueItems": true }, "data_paths": { "type": "array", "items": { "type": "string" } }, "endpoints": { "type": "array", "items": { "type": "string", "format": "uri" } } }, "additionalProperties": false },
    "configuration": { "type": "object", "required": ["name", "type"], "properties": { "name": { "type": "string" }, "type": { "enum": ["string", "integer", "number", "boolean", "array", "object"] }, "required": { "type": "boolean" }, "secret_reference": { "type": "boolean" }, "description": { "type": "string" } }, "additionalProperties": false },
    "authentication": {
      "type": "object",
      "required": ["methods", "bootstrap", "manual_steps"],
      "properties": {
        "methods": { "type": "array", "items": { "enum": ["local", "oidc", "oauth2", "api-token", "passkey", "none", "unknown"] }, "uniqueItems": true },
        "bootstrap": {
          "type": "object",
          "required": ["mode", "idempotent"],
          "properties": {
            "mode": { "enum": ["automatic", "first-run-ui", "api", "cli", "config", "none", "unsupported", "unknown"] },
            "idempotent": { "type": "boolean" },
            "credential_reference": { "type": "string" },
            "notes": { "type": "string" }
          },
          "additionalProperties": false
        },
        "token_lifecycle": { "type": "array", "items": { "enum": ["generate", "import", "rotate", "revoke", "unsupported", "unknown"] }, "uniqueItems": true },
        "manual_steps": { "type": "array", "items": { "type": "string" } },
        "oidc": {
          "type": "object",
          "properties": {
            "supported": { "type": "boolean" },
            "callback_path": { "type": "string" },
            "client_types": { "type": "array", "items": { "enum": ["public", "confidential"] }, "uniqueItems": true },
            "pkce": { "type": "boolean" },
            "pkce_methods": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "local_recovery": { "type": "boolean" },
            "verification": { "enum": ["untested", "partial", "passed", "failed"] },
            "notes": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
