{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aggregare.invalid/schemas/v1/identity-config.schema.json",
  "title": "Aggregare identity selection (v1)",
  "description": "Non-secret identity provider selection persisted by install.sh.",
  "type": "object",
  "required": ["schema_version", "identity_provider"],
  "properties": {
    "schema_version": { "const": 1 },
    "identity_provider": { "enum": ["kanidm", "external_oidc", "none"] }
  },
  "additionalProperties": false
}
